{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "EarthRanger Data Source"
    },
    "gee_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/GoogleEarthEngineConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Earth Engine Data Source"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "study_area": {
      "additionalProperties": false,
      "properties": {
        "spatial_features_group_name": {
          "title": "Spatial Features Group Name",
          "type": "string",
          "description": "The name of the group to fetch"
        }
      },
      "required": [
        "spatial_features_group_name"
      ],
      "type": "object",
      "title": "Study Area"
    },
    "er_patrol_and_events_params": {
      "additionalProperties": false,
      "properties": {
        "patrol_types": {
          "items": {
            "type": "string"
          },
          "title": "Patrol Types",
          "type": "array",
          "description": "Specify the patrol type(s) to analyze (optional). Leave empty to analyze all patrol types."
        },
        "event_types": {
          "items": {
            "type": "string"
          },
          "title": "Event Types",
          "type": "array",
          "description": "Specify the event type(s) to analyze (optional). Leave this section empty to analyze all event types."
        },
        "status": {
          "default": [
            "done"
          ],
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "active",
                "title": "Active"
              },
              {
                "const": "overdue",
                "title": "Overdue"
              },
              {
                "const": "done",
                "title": "Done"
              },
              {
                "const": "cancelled",
                "title": "Cancelled"
              }
            ]
          },
          "title": "Patrol Status",
          "type": "array",
          "description": "Choose to analyze patrols with a certain status. If left empty, patrols of all status will be analyzed",
          "uniqueItems": true,
          "ecoscope:advanced": true
        }
      },
      "required": [
        "patrol_types",
        "event_types"
      ],
      "type": "object",
      "title": ""
    },
    "patrol_filters": {
      "additionalProperties": false,
      "properties": {
        "bounding_box": {
          "allOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            }
          ],
          "default": {
            "min_y": -90.0,
            "max_y": 90.0,
            "min_x": -180.0,
            "max_x": 180.0
          },
          "title": "Bounding Box",
          "description": "Only include observations/events inside this bounding box.",
          "ecoscope:advanced": true
        },
        "filter_point_coords": {
          "default": [
            {
              "y": 90.0,
              "x": 180.0
            },
            {
              "y": 0.0,
              "x": 0.0
            },
            {
              "y": 1.0,
              "x": 1.0
            }
          ],
          "items": {
            "$ref": "#/$defs/Coordinate"
          },
          "title": "Filter Exact Point Coordinates",
          "type": "array",
          "description": "Exclude observations/events at these exact coordinates.",
          "ecoscope:advanced": true
        },
        "trajectory_segment_filter": {
          "allOf": [
            {
              "$ref": "#/$defs/TrajectorySegmentFilter"
            }
          ],
          "default": {
            "min_length_meters": 0.001,
            "max_length_meters": 100000,
            "min_time_secs": 1,
            "max_time_secs": 172800,
            "min_speed_kmhr": 0.01,
            "max_speed_kmhr": 500
          },
          "title": "Trajectory Filter",
          "description": "Drop trajectory segments outside these length/time/speed bounds.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Filters"
    },
    "meshgrid": {
      "additionalProperties": false,
      "properties": {
        "auto_scale_or_custom_cell_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutoScaleGridCellSize"
            },
            {
              "$ref": "#/$defs/CustomGridCellSize"
            }
          ],
          "default": {
            "auto_scale_or_custom": "Auto-scale"
          },
          "title": "Grid Cell Size",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Grid"
    },
    "gee_covariates": {
      "additionalProperties": false,
      "properties": {
        "covariates": {
          "default": [
            {
              "kind": "image_band",
              "name": "elevation",
              "image_id": "USGS/SRTMGL1_003",
              "band": "elevation",
              "reducer": "mean",
              "scale_m": 30.0,
              "multiplier": 1.0,
              "quadratic": false
            },
            {
              "kind": "terrain",
              "name": "slope",
              "derivative": "slope",
              "dem_image_id": "USGS/SRTMGL1_003",
              "band": "elevation",
              "scale_m": 30.0,
              "quadratic": false
            },
            {
              "kind": "collection_composite",
              "name": "ndvi",
              "collection_id": "MODIS/061/MOD13Q1",
              "band": "NDVI",
              "composite": "mean",
              "start_date": "",
              "end_date": "",
              "scale_m": 250.0,
              "multiplier": 0.0001,
              "quadratic": false
            }
          ],
          "items": {
            "discriminator": {
              "mapping": {
                "collection_composite": "#/$defs/CollectionCompositeCovariate",
                "gee_distance": "#/$defs/GeeDistanceCovariate",
                "image_band": "#/$defs/ImageBandCovariate",
                "terrain": "#/$defs/TerrainCovariate"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ImageBandCovariate"
              },
              {
                "$ref": "#/$defs/TerrainCovariate"
              },
              {
                "$ref": "#/$defs/CollectionCompositeCovariate"
              },
              {
                "$ref": "#/$defs/GeeDistanceCovariate"
              }
            ]
          },
          "title": "Earth Engine Covariates",
          "type": "array",
          "description": "Covariates sampled from Google Earth Engine for every grid cell."
        }
      },
      "type": "object",
      "required": [],
      "title": "Earth Engine Covariates"
    },
    "distance_covariates": {
      "additionalProperties": false,
      "properties": {
        "covariates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DistanceCovariate"
          },
          "title": "Distance Covariates",
          "type": "array",
          "description": "Distance from each cell centre to the nearest feature of your own layers (e.g. ranger stations, roads)."
        }
      },
      "type": "object",
      "required": [],
      "title": "Distance Covariates"
    },
    "occupancy_design": {
      "additionalProperties": false,
      "properties": {
        "min_effort_km": {
          "default": 0.5,
          "minimum": 0.0,
          "title": "Minimum Patrol Effort per Cell (km)",
          "type": "number",
          "description": "A cell counts as surveyed once patrols covered at least this distance in it; surveyed cells without a target event are absences."
        }
      },
      "required": [],
      "type": "object",
      "title": "Survey Design"
    },
    "occupancy_fit": {
      "additionalProperties": false,
      "properties": {
        "model_type": {
          "default": "cloglog_effort",
          "title": "Model Type",
          "description": "Effort-adjusted accounts for how far patrols went in each cell; Logistic treats every surveyed cell alike.",
          "oneOf": [
            {
              "const": "cloglog_effort",
              "title": "Effort-adjusted (cloglog + log effort)"
            },
            {
              "const": "logit",
              "title": "Logistic (presence/absence)"
            }
          ]
        },
        "prior_sd": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Coefficient Prior SD",
          "type": "number",
          "description": "Standard deviation of the Normal prior on each standardised coefficient; smaller shrinks harder.",
          "ecoscope:advanced": true
        },
        "holdout_fraction": {
          "default": 0.2,
          "exclusiveMaximum": 0.9,
          "minimum": 0.0,
          "title": "Holdout Fraction",
          "type": "number",
          "description": "Share of surveyed cells held out to measure predictive accuracy (AUC). 0 uses all cells.",
          "ecoscope:advanced": true
        },
        "mcmc": {
          "allOf": [
            {
              "$ref": "#/$defs/McmcSettings"
            }
          ],
          "default": {
            "draws": 1000,
            "tune": 1000,
            "chains": 2,
            "random_seed": 42
          },
          "title": "MCMC Sampling",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Occupancy Model"
    },
    "predicted": {
      "additionalProperties": false,
      "properties": {
        "reference_effort_km": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Reference Patrol Effort (km)",
          "type": "number",
          "description": "Effort-adjusted model only: predictions are the probability of at least one detection per this distance of patrolling."
        }
      },
      "required": [],
      "type": "object",
      "title": "Prediction"
    },
    "occupancy_zones": {
      "additionalProperties": false,
      "properties": {
        "min_patch_area_km2": {
          "default": 2.0,
          "minimum": 0.0,
          "title": "Minimum Zone Patch Area (km\u00b2)",
          "type": "number",
          "description": "Smaller patches are dropped."
        },
        "max_hole_area_km2": {
          "default": 2.0,
          "minimum": 0.0,
          "title": "Maximum Hole Area to Fill (km\u00b2)",
          "type": "number",
          "description": "Smaller holes inside a zone are filled."
        }
      },
      "required": [],
      "type": "object",
      "title": "Occupancy Zones"
    },
    "base_map_defs": {
